<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Password Reset - Future Fit</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f6f8; font-family: 'Helvetica Neue', sans-serif; color: #333;">
  <table width="100%" cellpadding="0" cellspacing="0" style="padding: 40px 0;">
    <tr>
      <td align="center">
        <table width="100%" style="max-width: 560px; background: #ffffff; border-radius: 10px; box-shadow: 0 4px 14px rgba(0,0,0,0.05); overflow: hidden;">

          <!-- Header Bar with Company Name -->
          <tr>
            <td style="background-color: #0e92b3; padding: 20px 32px; text-align: center;">
              <h1 style="margin: 0; color: #ffffff; font-size: 22px; font-weight: 600;">Future Fit</h1>
            </td>
          </tr>

          <!-- Main Message -->
          <tr>
            <td style="padding: 32px 32px 16px; text-align: left;">
              <h2 style="margin: 0; font-size: 20px; color: #0e92b3;">Password Reset Successful</h2>
              <p style="margin-top: 12px; font-size: 15px; color: #555;">
                Hi <strong><%= name %></strong>,<br>
                Your password has been reset. Use the password below to access your account.
              </p>
            </td>
          </tr>

          <!-- Password Card -->
          <tr>
            <td style="padding: 0 32px 24px;">
              <div style="background-color: #f1f4f7; border-radius: 8px; padding: 16px; text-align: center; border: 1px solid #dde4ea; font-size: 18px; color: #0e92b3; font-weight: 500;">
                <%= newPassword %>
              </div>
              <p style="margin-top: 20px; font-size: 13px; color: #777; text-align: center;">
                We recommend changing this after logging in for security.
              </p>
            </td>
          </tr>

          <!-- CTA -->
          <!-- <tr>
            <td style="padding: 0 32px 32px; text-align: center;">
              <a href="#" style="display: inline-block; background-color: #0e92b3; color: #fff; text-decoration: none; padding: 10px 24px; border-radius: 6px; font-size: 14px; font-weight: 500;">
                Log In to Future Fit
              </a>
            </td>
          </tr> -->

          <!-- Footer -->
          <tr>
            <td style="background-color: #fafbfc; padding: 20px 32px; text-align: center; font-size: 12px; color: #999;">
              &copy; <%= new Date().getFullYear() %> Future Fit. All rights reserved.
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
